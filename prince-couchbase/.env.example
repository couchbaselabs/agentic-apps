# ============================================================================
# PRINCE-on-Couchbase — environment configuration
# Copy to `.env` and fill in. Everything is read by backend/app/config.py.
# ============================================================================

# ---------------------------------------------------------------------------
# Couchbase Capella (cloud) connection
# ---------------------------------------------------------------------------
# From Capella: Cluster -> Connect -> "Connection String" (couchbases://...)
CB_CONNECTION_STRING=couchbases://cb.xxxxxxxx.cloud.couchbase.com
CB_USERNAME=prince_app
CB_PASSWORD=change-me-strong-password

# Logical layout (created by setup/create_collections.py)
CB_BUCKET=prince
CB_SCOPE=main

# Capella uses TLS by default. If you run a self-managed cluster without TLS,
# set CB_TLS=false and use couchbase:// in the connection string.
CB_TLS=true
# Path to a CA cert if your cluster needs one (Capella normally does NOT — leave blank).
CB_CERT_PATH=

# Names of the two Full-Text Search indexes created in setup/
CB_FTS_VECTOR_INDEX=prince_documents_vec
CB_FTS_TEXT_INDEX=prince_documents_text

# ---------------------------------------------------------------------------
# LLM — OpenAI-compatible, pluggable (mirrors PRINCE's unified endpoint)
# ---------------------------------------------------------------------------
# Point base_url at ANY OpenAI-compatible gateway (OpenAI, Anthropic-via-gateway,
# Azure, Ollama at http://localhost:11434/v1, vLLM, LiteLLM, etc.)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
# Strong reasoning model — planning, SQL generation, final synthesis
LLM_MODEL_STRONG=gpt-4o
# Fast/cheap model — keyword extraction, query expansion, metadata filters
LLM_MODEL_FAST=gpt-4o-mini

# Optional secondary provider used for automatic fallback (PRINCE "LLM fallback")
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL_STRONG=
LLM_FALLBACK_MODEL_FAST=

# Embeddings (OpenAI-compatible /embeddings endpoint)
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_API_KEY=sk-...
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536

# ---------------------------------------------------------------------------
# Mock mode — run the ENTIRE pipeline with NO API key (deterministic).
# Great for demos / CI. Set MOCK_LLM=true to bypass all network LLM calls.
# ---------------------------------------------------------------------------
MOCK_LLM=true

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ---------------------------------------------------------------------------
# Retrieval tuning (see ARCHITECTURE.md "Hybrid Retriever")
# ---------------------------------------------------------------------------
RAG_EXPANSIONS=5          # n query expansions
RAG_SEMANTIC_WEIGHT=0.7   # weighting for vector search
RAG_KEYWORD_WEIGHT=0.3    # weighting for FTS keyword search
RAG_INITIAL_K=20          # candidates before rerank
RAG_FINAL_K=7             # chunks after rerank
SQL_MAX_ROWS=50           # hard cap on Text-to-SQL++ result rows
SQL_MAX_RETRIES=3         # self-correction attempts
